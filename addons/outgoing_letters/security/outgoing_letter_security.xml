<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_outgoing_letters" model="ir.module.category">
        <field name="name">Outgoing Letters</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_outgoing_letter_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_outgoing_letters"/>
        <field name="comment">Can create, submit and print letters.</field>
    </record>

    <record id="group_outgoing_letter_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_outgoing_letters"/>
        <field name="implied_ids" eval="[(4, ref('group_outgoing_letter_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can also approve letters, mark them printable and reset them to draft.</field>
    </record>

    <!-- Every internal user is a letter user by default -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_outgoing_letter_user'))]"/>
    </record>
</odoo>
