<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════
         Dedicated Paperformat for Outgoing Letters
         (12mm margins all around, 0 top gap before header)
    ══════════════════════════════════════════ -->
    <record id="paperformat_outgoing_letter" model="report.paperformat">
        <field name="name">Outgoing Letter A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- ══════════════════════════════════════════
         Report Action
    ══════════════════════════════════════════ -->
    <record id="action_report_outgoing_letter" model="ir.actions.report">
        <field name="name">Outgoing Letter</field>
        <field name="model">outgoing.letter</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">outgoing_letters.report_outgoing_letter</field>
        <field name="report_file">outgoing_letters.report_outgoing_letter</field>
        <field name="print_report_name">'Letter - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_outgoing_letter"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- ══════════════════════════════════════════
         QWeb Template Adapting to Selected Document Layout
    ══════════════════════════════════════════ -->
    <template id="report_outgoing_letter">
        <t t-call="web.html_container">
            <div data-report-margin-top="6" data-report-header-spacing="0" data-report-margin-bottom="18" data-report-margin-left="12" data-report-margin-right="12">
            <t t-foreach="docs" t-as="o">
                <t t-set="comp" t-value="o.company_id or env.company"/>
                <t t-set="p_color" t-value="o.primary_color or comp.primary_color or '#1e293b'"/>
                <t t-set="s_color" t-value="o.secondary_color or comp.secondary_color or '#475569'"/>
                <t t-set="letter_logo" t-value="o._get_cropped_logo()"/>
                <t t-set="layout_name" t-value="o.report_layout_id.name or (comp.external_report_layout_id and ('Folder' if 'folder' in (comp.external_report_layout_id.key or '') else 'Boxed' if 'boxed' in (comp.external_report_layout_id.key or '') else 'Bold' if 'bold' in (comp.external_report_layout_id.key or '') else 'Striped' if 'striped' in (comp.external_report_layout_id.key or '') else 'Bubble' if 'bubble' in (comp.external_report_layout_id.key or '') else 'Wave' if 'wave' in (comp.external_report_layout_id.key or '') else 'Light')) or 'Light'"/>
                <t t-set="footer_text" t-value="o.letter_footer or o._default_letter_footer()"/>
                <t t-set="doc_font" t-value="comp.font or 'Lato'"/>

                <!-- Background Image URL -->
                <t t-set="bg_choice" t-value="o.layout_background or comp.layout_background or 'Blank'"/>
                <t t-set="bg_image_data" t-value="o.layout_background_image or (bg_choice == 'Custom' and comp.layout_background_image)"/>
                <t t-set="bg_url" t-value="'data:image/png;base64,%s' % bg_image_data.decode('utf-8') if bg_image_data and bg_choice == 'Custom' else ''"/>

                <!-- Clean horizontal accent divider under header (No enclosing box/borders) -->
                <t t-set="topbar_accent" t-value="'border-bottom: 2px solid ' + str(p_color) + '; padding-bottom: 6px; margin-bottom: 20px;'"/>

                <!-- ════ ARTICLE BODY (Letterhead placed directly inside to guarantee zero top void & 1:1 on-screen match) ════ -->
                <div class="article o_report_layout_standard" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"
                     t-attf-style="position: relative; font-family: '{{ doc_font }}', 'Ebrima', 'Nyala', 'Noto Sans Ethiopic', 'Segoe UI', Arial, sans-serif; font-size: 14px; line-height: 1.8; color: #1a1a1a;">

                    <style>
                        .article {
                            padding-top: 0 !important;
                            margin-top: 0 !important;
                        }
                        .page {
                            padding-top: 0 !important;
                            margin-top: 0 !important;
                        }
                        .ol_pdf_letterhead,
                        .ol_pdf_letterhead * {
                            box-sizing: border-box;
                        }
                        .ol_pdf_brand,
                        .ol_pdf_brand * {
                            border: none !important;
                            border-style: none !important;
                            border-width: 0 !important;
                            outline: none !important;
                            box-shadow: none !important;
                            background: transparent !important;
                        }
                        .ol_pdf_letterhead table {
                            border: none !important;
                            border-collapse: separate !important;
                        }
                        .ol_pdf_letterhead table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                            background: transparent !important;
                        }
                        .footer {
                            margin: 0 !important;
                            padding: 0 !important;
                        }
                        .footer table, .footer tr, .footer td {
                            border: none !important;
                        }
                        .ol_pdf_letterhead .ol_col_name > *:first-child,
                        .ol_pdf_letterhead .ol_col_name strong:first-child,
                        .ol_pdf_letterhead .ol_col_name b:first-child,
                        .ol_pdf_letterhead .ol_col_name p:first-child,
                        .ol_pdf_letterhead .ol_col_name div:first-child,
                        .ol_pdf_letterhead .ol_col_name h1,
                        .ol_pdf_letterhead .ol_col_name h2,
                        .ol_pdf_letterhead .ol_col_name h3 {
                            text-transform: uppercase !important;
                            font-size: 17px !important;
                            font-weight: 800 !important;
                            letter-spacing: 0.4px !important;
                            white-space: nowrap !important;
                            overflow: visible !important;
                            color: #0f172a !important;
                            line-height: 1.25 !important;
                            margin-bottom: 4px !important;
                        }
                    </style>

                    <!-- Geometric Watermark Pattern in PDF -->
                    <t t-if="bg_choice == 'Geometric'">
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; opacity: 0.12;">
                            <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <pattern id="geom_pat" width="80" height="80" patternUnits="userSpaceOnUse">
                                        <polygon points="40,4 76,40 40,76 4,40" fill="none" t-att-stroke="p_color" stroke-width="1.2"/>
                                        <circle cx="40" cy="40" r="18" fill="none" t-att-stroke="p_color" stroke-width="1"/>
                                        <polygon points="40,16 64,40 40,64 16,40" fill="none" t-att-stroke="s_color" stroke-width="0.8"/>
                                    </pattern>
                                </defs>
                                <rect width="100%" height="100%" fill="url(#geom_pat)"/>
                            </svg>
                        </div>
                    </t>

                    <!-- Custom Background Watermark in PDF -->
                    <t t-if="bg_choice == 'Custom' and bg_url">
                        <div style="position: absolute; top: 20%; left: 10%; width: 80%; height: 60%; z-index: -1; text-align: center; pointer-events: none; opacity: 0.12;">
                            <img t-att-src="bg_url" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Watermark"/>
                        </div>
                    </t>

                    <!-- Wave Decorative Header Shape -->
                    <t t-if="layout_name == 'Wave'">
                        <div style="position: absolute; top: -12mm; left: -12mm; right: -12mm; height: 110px; z-index: 0; pointer-events: none; overflow: hidden;">
                            <svg preserveAspectRatio="none" viewBox="0 0 1000 240" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%;">
                                <path d="M1000 230.734C937.384 240.621 803.83 250.266 562.185 220.602C311.343 189.809 104.626 201.375 0 211.598V0.5H1000V230.734Z" t-att-fill="p_color" fill-opacity=".12"/>
                            </svg>
                        </div>
                    </t>

                    <div class="page" t-attf-style="position: relative; z-index: 1; font-family: '{{ doc_font }}', 'Ebrima', 'Nyala', 'Noto Sans Ethiopic', 'Segoe UI', Arial, sans-serif;">

                        <!-- ════ ELEGANT 3-COLUMN LETTERHEAD (Unified Logo + Brand Lockup) ════ -->
                        <div class="ol_pdf_letterhead" t-attf-style="{{ topbar_accent }} width: 100%; clear: both; position: relative; z-index: 1; margin-top: -6px;">
                            <!-- Left: Unified Logo + Company Name & Address Lockup (Aligned as one cohesive brand mark, NO border) -->
                            <div class="ol_pdf_brand" style="float: left; max-width: 66%; border: none !important; outline: none !important; box-shadow: none !important; background: transparent !important;">
                                <div style="display: table; border: none !important; border-style: none !important; border-width: 0 !important; border-collapse: separate !important; border-spacing: 0; margin: 0; padding: 0; outline: none !important; box-shadow: none !important; background: transparent !important;">
                                    <div style="display: table-row; border: none !important; border-style: none !important; border-width: 0 !important; background: transparent !important;">
                                        <div style="display: table-cell; vertical-align: middle; padding: 0; padding-right: 14px; border: none !important; border-style: none !important; border-width: 0 !important; outline: none !important; background: transparent !important;">
                                            <img t-if="letter_logo" t-att-src="image_data_uri(letter_logo)"
                                                 style="max-height: 105px; max-width: 260px; object-fit: contain; display: block; border: none !important; outline: none !important; box-shadow: none !important;"
                                                 alt="Logo"/>
                                        </div>
                                        <div style="display: table-cell; vertical-align: middle; padding: 0; border: none !important; border-style: none !important; border-width: 0 !important; outline: none !important; background: transparent !important; white-space: nowrap;">
                                            <div style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 2px; line-height: 1.25; border: none !important; white-space: nowrap;">
                                                <span>ዌኬር ፋርማሲዉቲካልስ ኃለ/የተ/የግ/ማህበር</span>
                                            </div>
                                            <div style="font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; color: #0f172a; margin-bottom: 3px; line-height: 1.2; border: none !important;">
                                                <span t-out="(comp.name or 'WECARE PHARMACEUTICALS PLC').upper()"/>
                                            </div>
                                            <div style="font-size: 12px; color: #475569; line-height: 1.4; white-space: nowrap; border: none !important;">
                                                Addis Abeba, Ethiopia.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Bilingual Ref No & Date (Moved down to align with brand mark) -->
                            <div style="float: right; width: 220px; margin: 0; padding: 0; padding-top: 22px; text-align: left;">
                                <!-- Ref No Row -->
                                <div style="width: 100%; margin-bottom: 8px; clear: both; overflow: hidden;">
                                    <div style="float: left; width: 52px; line-height: 1.15;">
                                        <div style="font-weight: 700; font-size: 12.5px; color: #0f172a; line-height: 1.1;">ቁጥር</div>
                                        <div style="font-size: 11px; font-weight: 600; color: #475569; line-height: 1.1;">Ref.No.</div>
                                    </div>
                                    <div style="float: right; width: 162px; border-bottom: 1.5px solid #1e293b; padding-bottom: 1px; font-size: 12.5px; font-weight: 600; color: #0f172a; line-height: 1.5; min-height: 22px;">
                                        <span t-field="o.name"/>
                                    </div>
                                    <div style="clear: both;"></div>
                                </div>
                                <!-- Date Row -->
                                <div style="width: 100%; clear: both; overflow: hidden;">
                                    <div style="float: left; width: 52px; line-height: 1.15;">
                                        <div style="font-weight: 700; font-size: 12.5px; color: #0f172a; line-height: 1.1;">ቀን</div>
                                        <div style="font-size: 11px; font-weight: 600; color: #475569; line-height: 1.1;">Date</div>
                                    </div>
                                    <div style="float: right; width: 162px; border-bottom: 1.5px solid #1e293b; padding-bottom: 1px; font-size: 12.5px; font-weight: 600; color: #0f172a; line-height: 1.5; min-height: 22px;">
                                        <span t-field="o.date"/>
                                    </div>
                                    <div style="clear: both;"></div>
                                </div>
                            </div>
                            <div style="clear: both; height: 0; font-size: 0; line-height: 0;"></div>
                        </div>

                        <!-- Letter Content -->
                        <div style="font-size: 14px; line-height: 1.8;">
                            <div t-field="o.content"/>
                        </div>

                        <!-- Greeting, Signature & Company Stamp (Greeting positioned above signature, 50% signature overlap on stamp) -->
                        <div class="clearfix mt-4" style="page-break-inside: avoid; text-align: right; padding-right: 15px; margin-top: 28px;">
                            <!-- Greeting shifted left to sit directly above signature -->
                            <div t-if="o.greeting" style="font-weight: 700; font-size: 14.5px; margin-bottom: 12px; color: #1e293b; padding-right: 120px; text-align: right;">
                                <span t-out="o.greeting"/>
                            </div>

                            <div style="display: inline-block; position: relative; vertical-align: bottom;">
                                <!-- Stamp behind -->
                                <div t-if="comp and comp.company_stamp"
                                     style="display: inline-block; vertical-align: bottom; position: relative; z-index: 1;">
                                    <img t-att-src="image_data_uri(comp.company_stamp)"
                                         style="max-height: 175px; max-width: 250px; object-fit: contain; border: 0 !important; outline: none !important; box-shadow: none !important;"
                                         alt="Company Stamp"/>
                                </div>
                                <!-- Signature on top, 50% overlap into stamp, z-index: 20 -->
                                <div t-if="o.approver_signature"
                                     style="position: absolute; top: 15%; left: -110px; width: 240px; text-align: center; z-index: 20;">
                                    <img t-att-src="image_data_uri(o.approver_signature)"
                                         style="max-height: 130px; max-width: 240px; object-fit: contain; border: 0 !important; outline: none !important; box-shadow: none !important; position: relative; z-index: 20;"
                                         alt="Signature"/>
                                    <div t-if="o.approver_name"
                                         style="font-size: 11px; font-weight: 600; color: #222; border-top: 1px dotted #777; padding-top: 3px; margin-top: 3px; white-space: nowrap; position: relative; z-index: 20;">
                                        <span t-out="o.approver_name"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ════ REAL WKHTMLTOPDF FOOTER (Clean footer pinned to bottom margin) ════ -->
                <div class="footer" t-attf-style="margin: 0 !important; padding: 0 !important; font-family: '{{ doc_font }}', 'Ebrima', 'Nyala', 'Noto Sans Ethiopic', 'Segoe UI', Arial, sans-serif; position: relative;">
                    <!-- Wave Decorative Footer Shape -->
                     
                    <t t-if="layout_name == 'Wave'">
                        <div style="position: absolute; bottom: 0; left: -12mm; right: -12mm; height: 75px; z-index: 0; pointer-events: none; overflow: hidden;">
                            <svg preserveAspectRatio="none" viewBox="0 0 1000 180" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%;">
                                <path d="M427.731 19.757C686.904 51.3469 898.971 38.039 1000 27.6922V180H0V8.20934C66.363 -0.991089 198.347 -8.20218 427.731 19.757Z" t-att-fill="s_color" fill-opacity=".12"/>
                            </svg>
                        </div>
                    </t>
                    <div style="width: 100%; position: relative; z-index: 1;">
                        <t t-if="o.letter_footer">
                            <span t-field="o.letter_footer"/>
                        </t>
                        <t t-else="">
                            <div style="border-top: 1.5px solid #222; padding-top: 6px; text-align: center; font-size: 11px; line-height: 1.5; color: #222;">
                                <p style="margin: 0; padding: 0;"><strong>E-mail:</strong> info@wecarepharmaceuticals.com &amp;nbsp;&amp;nbsp;&amp;nbsp; <strong>Website:</strong> https://wecarepharmaceuticals.com/</p>
                                <p style="margin: 0; padding: 0;"><strong>Tel:</strong> +251-116 674 939 / +251 913 784 547 / +251 911 223 102</p>
                                <p style="margin: 0; padding: 0;"><strong>Address:</strong> Welo Sefer, Near Wengelawit Building: Addis Ababa: Ethiopia</p>
                            </div>
                        </t>
                    </div>
                </div>

            </t>
            </div>
        </t>
    </template>

</odoo>
