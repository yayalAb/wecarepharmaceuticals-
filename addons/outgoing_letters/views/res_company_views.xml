<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_company_stamp" model="ir.ui.view">
        <field name="name">res.company.form.inherit.company_stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="company_stamp" widget="image" options="{'preview_image': 'company_stamp'}" style="max-width: 120px; max-height: 120px;"/>
            </xpath>
        </field>
    </record>
</odoo>
