<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='totals.subtotals']/tr/td[contains(@class, 'o_list_monetary')]" position="before">
            <td class="text-end pe-3"/>
        </xpath>
        <xpath expr="//tr[@t-if=&quot;'cash_rounding_base_amount_currency' in totals&quot;]/td[contains(@class, 'o_list_monetary')]" position="before">
            <td class="text-end pe-3"/>
        </xpath>
        <xpath expr="//tr[td/span[@name='amount_total']]/td[contains(@class, 'o_list_monetary')]" position="before">
            <td class="text-end pe-3"/>
        </xpath>
        <xpath expr="//tr[td/span[@name='amount_total']]//label[contains(@class, 'o_tax_total_label')]" position="replace">
            <label class="o_form_label o_tax_total_label" t-out="totals.total_label || 'Total'">Total</label>
        </xpath>
    </t>

    <t t-inherit="account.TaxGroupComponent" t-inherit-mode="extension">
        <xpath expr="//td[contains(@class, 'o_tax_group')]" position="before">
            <td class="o_tax_group_base text-end pe-3" style="white-space: nowrap;">
                <span t-if="props.taxGroup.display_base_amount_currency !== undefined"
                      t-out="formatMonetary(props.taxGroup.display_base_amount_currency)"/>
            </td>
        </xpath>
    </t>
</templates>
