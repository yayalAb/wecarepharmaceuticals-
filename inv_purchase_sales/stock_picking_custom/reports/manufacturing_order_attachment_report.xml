<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_manufacturing_order_attachment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="stock_picking_custom.report_manufacturing_order_attachment_document"
                    t-lang="o.company_id.partner_id.lang" />
            </t>
        </t>
    </template>

    <template id="report_manufacturing_order_attachment_document">
        <t t-set="o" t-value="o.with_context(lang=o.company_id.partner_id.lang or user.lang)" />
        <t t-set="doc_title" t-value="'Manufacturing Order Attachment'" />
        <t t-set="doc_number" t-value="o.name" />
        <t t-set="issue_number" t-value="'1'" />
        <t t-set="prepared_by" t-value="o.get_moa_prepared_by()" />
        <t t-set="approved_by" t-value="o.get_moa_approved_by()" />
        <t t-call="web.external_layout">
            <t t-call="stock_picking_custom.moa_body" />
        </t>
    </template>

    <template id="moa_body">
        <style type="text/css">
            .moa-page {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-size: 10px;
                color: #000;
                padding: 0 4px 12px;
            }
            .moa-title {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                text-align: center;
                font-size: 16px;
                font-weight: bold;
                color: #c00000;
                margin: 0 0 14px 0;
            }
            .moa-row4 {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 10px;
                font-size: 9.5px;
            }
            .moa-cell {
                display: table-cell;
                width: 25%;
                vertical-align: bottom;
                padding-right: 10px;
            }
            .moa-cell:last-child { padding-right: 0; }
            .moa-field { margin-bottom: 10px; overflow: hidden; }
            .moa-lbl {
                font-weight: bold;
                float: left;
                margin-right: 4px;
                line-height: 1.3;
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
            }
            .moa-und {
                display: block;
                overflow: hidden;
                border-bottom: 1px solid #000;
                min-height: 16px;
                padding: 0 0 4px 2px;
            }
            .moa-und-dashed { border-bottom: 1px dashed #000; }
            .moa-cols {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 10px;
                font-size: 9.5px;
            }
            .moa-col {
                display: table-cell;
                width: 50%;
                vertical-align: top;
                padding-right: 14px;
            }
            .moa-col-right {
                display: table-cell;
                width: 50%;
                vertical-align: top;
                padding-left: 16px;
            }
            .moa-section {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-weight: bold;
                margin: 12px 0 6px 0;
                font-size: 11px;
            }
            .moa-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5px;
                margin-bottom: 10px;
                table-layout: fixed;
            }
            .moa-table th,
            .moa-table td {
                border: 1px solid #000;
                padding: 4px 3px;
                vertical-align: middle;
                word-wrap: break-word;
            }
            .moa-table th {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                background: #e8e0f0;
                font-weight: bold;
                text-align: center;
                line-height: 1.2;
            }
            .moa-num { text-align: right; white-space: nowrap; }
            .moa-center { text-align: center; }
            .moa-desc { text-align: left; }
            .moa-line {
                border-bottom: 1px solid #000;
                min-height: 22px;
                padding: 0 2px 5px 2px;
                margin-bottom: 6px;
            }
            .moa-appr { margin-top: 6px; font-size: 10px; }
            .moa-appr-row {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 14px;
                padding-bottom: 14px;
                border-bottom: 1px dotted #aaa;
            }
            .moa-appr-row:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }
            .moa-appr-title {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                display: table-cell;
                font-weight: bold;
                width: 20%;
                vertical-align: bottom;
                padding: 0 10px 4px 0;
            }
            .moa-appr-slot {
                display: table-cell;
                vertical-align: bottom;
                width: 26.67%;
                padding: 0 12px 0 0;
            }
            .moa-appr-slot .moa-field { margin-bottom: 0; }
            .moa-appr-slot .moa-lbl { font-weight: normal; }
            .moa-appr-slot .moa-und { min-height: 16px; padding-bottom: 4px; }
            .moa-copy {
                margin-top: 16px;
                font-size: 10px;
                border-top: 1px solid #ccc;
                padding-top: 8px;
                text-align: center;
            }
        </style>

        <div class="page moa-page" style="position: relative; min-height: 850px; padding-bottom: 110px;">
            <div class="oe_structure" />

            <t t-call="stock_picking_custom.op_info_boxes">
                <t t-set="info_left" t-value="[('Finished Goods', o.product_id.name), ('Planned Qty', '{0:,.2f} {1}'.format(o.product_qty or 0.0, o.product_uom_id.name or '')), ('Produced Qty', '{0:,.2f} {1}'.format(o.qty_produced or 0.0, o.product_uom_id.name or '')), ('Ref.', o.origin), ('Remark', o.mo_attachment_reason)]" />
                <t t-set="info_right" t-value="[('Voucher No', o.name), ('Date', (context_timestamp(o.date_start).strftime('%d/%m/%Y %H:%M:%S') if o.date_start else '')), ('Machine', o.get_moa_machine_name()), ('Operator', o.user_id.name), ('Store', '=&gt;' + (o.location_dest_id.complete_name or ''))]" />
            </t>

            <div class="moa-section">Raw Material Consumption</div>
            <table class="moa-table">
                <thead style="display: table-header-group;">
                    <tr>
                        <th style="width:5%;">No</th>
                        <th style="width:28%; text-align: left;">Raw Material</th>
                        <th style="width:14%;">Planned Qty</th>
                        <th style="width:14%;">Consumed Qty</th>
                        <th style="width:12%;">UOM</th>
                        <th style="width:17%;">Remark</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="rm_count" t-value="0" />
                    <t t-foreach="o.get_moa_raw_material_moves()" t-as="move">
                        <t t-set="rm_count" t-value="rm_count + 1" />
                        <tr style="page-break-inside: avoid;">
                            <td class="moa-center"><span t-esc="rm_count" /></td>
                            <td class="moa-desc">
                                <div t-esc="move.product_id.name or move.name or ''" /><div t-foreach="move.get_report_lot_lines()" t-as="lot_line" t-esc="lot_line" style="font-size: 0.9em;" />
                            </td>
                            <td class="moa-num">
                                <span t-esc="'{0:,.2f}'.format(move.product_uom_qty or 0.0)" />
                            </td>
                            <td class="moa-num">
                                <span t-esc="'{0:,.2f}'.format(o.get_moa_consumed_qty(move))" />
                            </td>
                            <td class="moa-center">
                                <span t-esc="move.product_uom.name or ''" />
                            </td>
                            <td class="moa-desc">&#160;</td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <div class="moa-section">By-Product Information</div>
            <table class="moa-table">
                <thead style="display: table-header-group;">
                    <tr>
                        <th style="width:5%;">No</th>
                        <th style="width:35%; text-align: left;">By-Product Name</th>
                        <th style="width:18%;">Quantity</th>
                        <th style="width:15%;">UOM</th>
                        <th style="width:17%;">Remark</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="bp_count" t-value="0" />
                    <t t-foreach="o.get_moa_byproduct_moves()" t-as="move">
                        <t t-set="bp_count" t-value="bp_count + 1" />
                        <tr style="page-break-inside: avoid;">
                            <td class="moa-center"><span t-esc="bp_count" /></td>
                            <td class="moa-desc">
                                <div t-esc="move.product_id.name or move.name or ''" /><div t-foreach="move.get_report_lot_lines()" t-as="lot_line" t-esc="lot_line" style="font-size: 0.9em;" />
                            </td>
                            <td class="moa-num">
                                <span t-esc="'{0:,.2f}'.format(o.get_moa_byproduct_qty(move))" />
                            </td>
                            <td class="moa-center">
                                <span t-esc="move.product_uom.name or ''" />
                            </td>
                            <td class="moa-desc">&#160;</td>
                        </tr>
                    </t>
                </tbody>
            </table>


            <!-- Approval + copy distribution pinned to the bottom of the page -->
            <div style="position: absolute; left: 4px; right: 4px; bottom: 0;">
                <t t-call="stock_picking_custom.op_approval_line">
                    <t t-set="prepared_name" t-value="prepared_by.name if prepared_by else ''"/>
                    <t t-set="received_name" t-value="o.location_dest_id.warehouse_id.storeman_id.name or ''"/>
                    <t t-set="approved_name" t-value="approved_by.name if approved_by else ''"/>
                </t>
                <div class="moa-copy" style="display: block; width: 100%; text-align: center;">
                <strong>Copy Distribution:</strong>
                Original-Store &#160;|&#160; 1st Copy Finance
            </div>
            </div>
        </div>
    </template>
</odoo>
