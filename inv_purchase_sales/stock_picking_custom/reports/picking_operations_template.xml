    <template id="sia_body">
        <style type="text/css">
            .sia-page { font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; font-size: 12px; color: #000; padding: 0 4px 12px; }
            .sia-title { font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; text-align: center; font-size: 18px; font-weight: bold; color: #c00000; margin: 0 0 20px 0; }
            .sia-form-row { display: table; width: 100%; table-layout: fixed; margin-bottom: 12px; }
            .sia-form-half { display: table-cell; width: 50%; vertical-align: bottom; padding-right: 24px; }
            .sia-form-half:last-child { padding-right: 0; padding-left: 8px; }
            .sia-form-group { display: table; width: 100%; table-layout: fixed; }
            .sia-label { font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; font-weight: bold; white-space: nowrap; display: table-cell; width: 148px; vertical-align: bottom; padding-right: 8px; padding-bottom: 4px; }
            .sia-field-wrap { display: table-cell; width: auto; vertical-align: bottom; }
            .sia-field-line { display: block; width: 100%; min-height: 24px; border-bottom: 1px solid #000; padding: 3px 0 2px 10px; box-sizing: border-box; }
            .sia-label-wide { width: 200px; }
            .sia-section-title { font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; font-weight: bold; margin: 14px 0 8px 0; }
            .sia-field-full { display: block; width: 100%; margin-bottom: 8px; }
            .sia-items-table { width: 100%; border-collapse: collapse; margin-top: 4px; }
            .sia-items-table th, .sia-items-table td { border: 1px solid #000; padding: 5px 6px; vertical-align: middle; }
            .sia-items-table th { font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; font-weight: bold; text-align: center; font-size: 11px; background-color: #e8e0f0; }
            .sia-items-table tbody td { min-height: 28px; height: 28px; }
            .sia-approval-row { display: table; width: 100%; table-layout: fixed; margin-bottom: 16px; }
            .sia-approval-role { font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; display: table-cell; font-weight: bold; width: 14%; vertical-align: bottom; padding-bottom: 4px; padding-right: 6px; }
            .sia-approval-name-wrap { display: table-cell; width: 26%; vertical-align: bottom; padding-right: 14px; }
            .sia-approval-sig-label { display: table-cell; font-weight: bold; width: 4%; text-align: center; vertical-align: bottom; padding-bottom: 4px; }
            .sia-approval-sig-wrap { display: table-cell; width: 36%; vertical-align: bottom; padding-right: 14px; }
            .sia-approval-date-label { display: table-cell; font-weight: bold; width: 5%; text-align: center; vertical-align: bottom; padding-bottom: 4px; }
            .sia-approval-date-wrap { display: table-cell; width: 15%; vertical-align: bottom; }
            .sia-sig-box { width: 100%; min-height: 50px; border-bottom: 1px solid #000; text-align: center; padding-bottom: 2px; box-sizing: border-box; }
            .sia-copy-dist { margin-top: 28px; font-size: 11px; text-align: center; }
        </style>

        <div class="page sia-page" style="position: relative; min-height: 850px; padding-bottom: 110px;">
            <div class="oe_structure" />
            <t t-call="stock_picking_custom.op_info_boxes">
                <t t-set="info_left" t-value="[('Requested By', o.store_request_id.requested_by.name), ('Department', o.store_request_id.department_id.name), ('Ref.', o.store_request_id.name or o.origin), ('Remark', o.note)]" />
                <t t-set="info_right" t-value="[('Voucher No', o.name), ('Date', (context_timestamp((o.date_done or o.scheduled_date)).strftime('%d/%m/%Y %H:%M:%S') if (o.date_done or o.scheduled_date) else '')), ('From', '=&gt;' + (o.location_id.complete_name or '')), ('To', '=&gt;' + (o.location_dest_id.complete_name or ''))]" />
            </t>

            <table class="sia-items-table">
                <thead style="display: table-header-group;">
                    <tr>
                        <th style="width: 4%;">S.N</th>
                        <th style="width: 32%; text-align: left;">Item Description</th>
                        <th style="width: 10%;">Unit of Measure</th>
                        <th style="width: 11%;">Quantity Requested</th>
                        <th style="width: 11%;">Issued Quantity</th>
                        <th style="width: 10%;">Unit Price</th>
                        <th style="width: 12%;">Total Unit Price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="row_count" t-value="0" />
                    <t t-foreach="o.move_ids_without_package" t-as="move">
                        <t t-set="row_count" t-value="row_count + 1" />
                        <tr style="page-break-inside: avoid;">
                            <td class="text-center"><span t-esc="row_count" /></td>
                            <td><div t-esc="move.product_id.name or move.name or ''" /><div t-foreach="move.get_report_lot_lines()" t-as="lot_line" t-esc="lot_line" style="font-size: 0.9em;" /></td>
                            <td class="text-center"><span t-field="move.product_uom.name" /></td>
                            <td class="text-end">
                                <span t-esc="'{0:,.2f}'.format(move.product_uom_qty)" />
                            </td>
                            <td class="text-end">
                                <span t-esc="'{0:,.2f}'.format(move.quantity)" />
                            </td>
                            <td class="text-end">
                                <span t-esc="'{0:,.2f}'.format(move.line_unit_price or 0.0)" />
                            </td>
                            <td class="text-end">
                                <span t-esc="'{0:,.2f}'.format(move.line_subtotal or 0.0)" />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-set="storeman_user" t-value="o.location_id.warehouse_id.storeman_id" />

            <!-- Approval + copy distribution pinned to the bottom of the page -->
            <div style="position: absolute; left: 4px; right: 4px; bottom: 0;">
                <t t-call="stock_picking_custom.op_approval_line">
                    <t t-set="prepared_name" t-value="o.create_uid.name"/>
                    <t t-set="received_name" t-value="o.store_request_id.requested_by.name if o.store_request_id else '' or ''"/>
                    <t t-set="approved_name" t-value="o.approved_by.name or ''"/>
                </t>
                <div class="sia-copy-dist" style="display: block; width: 100%; text-align: center;">
                    <strong>Copy Distribution:</strong>
                    <span style="margin-left: 10px;">Original-Accounts</span>
                    <span style="margin-left: 16px;">1st Requisitioning</span>
                    <span style="margin-left: 16px;">3rd Store Keeper</span>
                    <span style="margin-left: 16px;">4th Pad</span>
                </div>
            </div>
        </div>
    </template>

