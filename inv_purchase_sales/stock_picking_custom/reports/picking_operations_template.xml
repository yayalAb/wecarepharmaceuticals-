<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_body_inherit" inherit_id="stock.report_picking">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page"
                style="font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif; font-size: 12px; padding: 0 30px;">
                <div class="oe_structure" />

            </div>
        </xpath>
    </template>

    <!-- Single-line approval row shared by all inventory operation documents:
         Prepared By ____   Received By ____   Approved By ____
         Callers set prepared_name / received_name / approved_name. -->
    <template id="op_approval_line">
        <div style="width: 100%; margin-top: 36px; font-size: 11px; white-space: nowrap; page-break-inside: avoid;">
            <strong>Prepared By:</strong>
            <span style="display: inline-block; width: 21%; border-bottom: 1px solid #000; padding: 0 4px 2px 4px; margin-right: 3%; vertical-align: bottom;"><t t-out="prepared_name or ''"/>&#160;</span>
            <strong>Received By:</strong>
            <span style="display: inline-block; width: 21%; border-bottom: 1px solid #000; padding: 0 4px 2px 4px; margin-right: 3%; vertical-align: bottom;"><t t-out="received_name or ''"/>&#160;</span>
            <strong>Approved By:</strong>
            <span style="display: inline-block; width: 21%; border-bottom: 1px solid #000; padding: 0 4px 2px 4px; vertical-align: bottom;"><t t-out="approved_name or ''"/>&#160;</span>
        </div>
    </template>

    <!-- Two bordered information boxes shared by all operation documents.
         Callers set info_left / info_right as lists of (label, value); the first
         value of each box is printed bold. -->
    <template id="op_info_boxes">
        <t t-set="box" t-value="'display: table-cell; vertical-align: top; border: 1px solid #555; border-radius: 4px; padding: 6px 10px;'" />
        <t t-set="lbl" t-value="'display: table-cell; width: 78px; white-space: nowrap; color: #333; padding: 2px 0;'" />
        <t t-set="val" t-value="'display: table-cell; padding: 2px 0 2px 6px;'" />
        <div style="display: table; width: 100%; margin: 6px 0 12px 0; font-size: 11px;">
            <div t-att-style="box + ' width: 62%;'">
                <div style="display: table; width: 100%;">
                    <div t-foreach="info_left" t-as="row" style="display: table-row;">
                        <span t-att-style="lbl" t-esc="row[0]" />
                        <span t-att-style="val + (' font-weight: bold;' if row_first else '')" t-out="row[1] or ''" />
                    </div>
                </div>
            </div>
            <div style="display: table-cell; width: 2%;" />
            <div t-att-style="box + ' width: 36%;'">
                <div style="display: table; width: 100%;">
                    <div t-foreach="info_right" t-as="row" style="display: table-row;">
                        <span t-att-style="lbl" t-esc="row[0]" />
                        <span t-att-style="val + (' font-weight: bold;' if row_first else '')" t-out="row[1] or ''" />
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="cgrn_body">
        <style>
            .cgrn-page {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-size: 12px;
                color: #000;
                padding: 4px 20px 12px;
            }
            .cgrn-title {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                color: #c00000;
                font-weight: bold;
                font-size: 18px;
                text-align: center;
                margin: 0 0 20px 0;
                letter-spacing: 0.3px;
            }
            .cgrn-section-title {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-weight: bold;
                margin: 16px 0 6px 0;
                font-size: 12px;
            }
            .cgrn-form-row {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 10px;
            }
            .cgrn-form-third {
                display: table-cell;
                width: 33.33%;
                vertical-align: top;
                padding-right: 14px;
            }
            .cgrn-form-third:last-child {
                padding-right: 0;
            }
            .cgrn-form-half {
                display: table-cell;
                width: 50%;
                vertical-align: top;
                padding-right: 20px;
            }
            .cgrn-form-half:last-child {
                padding-right: 0;
                padding-left: 12px;
            }
            .cgrn-form-group {
                display: table;
                width: 100%;
                table-layout: fixed;
            }
            .cgrn-label {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-weight: bold;
                white-space: nowrap;
                display: table-cell;
                vertical-align: bottom;
                padding-right: 8px;
                padding-bottom: 4px;
                font-size: 11px;
            }
            .cgrn-label-sm { width: 88px; }
            .cgrn-label-md { width: 118px; }
            .cgrn-label-lg { width: 155px; }
            .cgrn-field-wrap {
                display: table-cell;
                width: auto;
                vertical-align: bottom;
            }
            .cgrn-field-line {
                display: block;
                width: 100%;
                min-height: 22px;
                border-bottom: 1px solid #000;
                padding: 2px 0 3px 8px;
                line-height: 1.35;
                box-sizing: border-box;
            }
            .cgrn-field-line-dashed {
                border-bottom: 1px dashed #000;
                min-height: 24px;
                padding: 3px 0 2px 10px;
            }
            .cgrn-field-line-tall { min-height: 28px; }
            .cgrn-field-full {
                display: block;
                width: 100%;
                margin-bottom: 8px;
            }
            .cgrn-items-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 4px;
            }
            .cgrn-items-table th,
            .cgrn-items-table td {
                border: 1px solid #000;
                padding: 5px 6px;
                vertical-align: middle;
            }
            .cgrn-items-table th {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-weight: bold;
                text-align: center;
                font-size: 9px;
                line-height: 1.2;
                background-color: #e8e8f0;
            }
            .cgrn-items-table tbody td {
                min-height: 26px;
                font-size: 11px;
            }
            .cgrn-td-desc { text-align: left; word-wrap: break-word; }
            .cgrn-td-num { text-align: right; white-space: nowrap; }
            .cgrn-td-center { text-align: center; white-space: nowrap; }
            .cgrn-totals-wrap { margin-top: 10px; width: 100%; }
            .cgrn-totals-row {
                display: table;
                width: 58%;
                margin-left: auto;
                margin-bottom: 6px;
                table-layout: fixed;
            }
            .cgrn-totals-label {
                display: table-cell;
                font-weight: bold;
                width: 120px;
                vertical-align: bottom;
                padding-right: 8px;
                padding-bottom: 4px;
            }
            .cgrn-totals-value {
                display: table-cell;
                vertical-align: bottom;
            }
            .cgrn-quality-row {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                margin-top: 10px;
                font-weight: bold;
                font-size: 11px;
            }
            .cgrn-approval-row {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 16px;
            }
            .cgrn-approval-role {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                display: table-cell;
                font-weight: bold;
                width: 22%;
                vertical-align: bottom;
                padding-bottom: 4px;
                padding-right: 6px;
                font-size: 11px;
                line-height: 1.25;
            }
            .cgrn-approval-name-wrap {
                display: table-cell;
                width: 24%;
                vertical-align: bottom;
                padding-right: 14px;
            }
            .cgrn-approval-sig-label {
                display: table-cell;
                font-weight: bold;
                width: 4%;
                text-align: center;
                vertical-align: bottom;
                padding-bottom: 4px;
            }
            .cgrn-approval-sig-wrap {
                display: table-cell;
                width: 34%;
                vertical-align: bottom;
                padding-right: 14px;
            }
            .cgrn-approval-date-label {
                display: table-cell;
                font-weight: bold;
                width: 5%;
                text-align: center;
                vertical-align: bottom;
                padding-bottom: 4px;
            }
            .cgrn-approval-date-wrap {
                display: table-cell;
                width: 13%;
                vertical-align: bottom;
            }
            .cgrn-sig-box {
                width: 100%;
                min-height: 50px;
                border-bottom: 1px solid #000;
                text-align: center;
                padding-bottom: 2px;
                box-sizing: border-box;
            }
            .cgrn-copy-dist {
                margin-top: 28px;
                font-size: 11px;
                text-align: left;
            }
        </style>

        <t t-set="storeman_user"
            t-value="o.location_dest_id.warehouse_id.storeman_id if o.location_dest_id and o.location_dest_id.warehouse_id else False" />

        <div class="page cgrn-page" style="position: relative; min-height: 850px; padding-bottom: 110px;">

            <div class="oe_structure" />

            <t t-call="stock_picking_custom.op_info_boxes">
                <t t-set="info_left" t-value="[('To', o.partner_id.display_name), ('TIN No', o.partner_id.vat), ('Address', o.partner_id.contact_address_complete), ('Ref.', o.get_grn_so_po_ref() or o.origin), ('Remark', o.note)]" />
                <t t-set="info_right" t-value="[('Voucher No', o.name), ('Date', (context_timestamp((o.date_done or o.scheduled_date)).strftime('%d/%m/%Y %H:%M:%S') if (o.date_done or o.scheduled_date) else '')), ('Cert', (('certificate_number' in o.partner_id._fields and o.partner_id.certificate_number) or '')), ('Store', '=&gt;' + (o.location_dest_id.complete_name or ''))]" />
            </t>

            <table id="cgrn_item_table" class="cgrn-items-table">
                <thead style="display: table-header-group;">
                    <tr>
                        <th style="width:4%;">S.N</th>
                        <th style="width:36%; text-align: left;">Item Description</th>
                        <th style="width:10%;">UOM</th>
                        <th style="width:12%;">Quantity</th>
                        <th style="width:12%;">Unit Price</th>
                        <th style="width:14%;">Total Unit Price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="row_count" t-value="0" />
                    <t t-foreach="o.move_ids_without_package" t-as="move">
                        <t t-if="move.state != 'cancel'">
                            <t t-set="row_count" t-value="row_count + 1" />
                            <t t-set="line_total" t-value="o.get_grn_line_total(move)" />
                            <tr style="page-break-inside: avoid;">
                                <td class="cgrn-td-center"><span t-esc="row_count" /></td>
                                <td class="cgrn-td-desc">
                                    <div t-esc="move.product_id.name or move.name or ''" /><div t-foreach="move.get_report_lot_lines()" t-as="lot_line" t-esc="lot_line" style="font-size: 0.9em;" />
                                </td>
                                <td class="cgrn-td-center">
                                    <span t-esc="move.product_uom.name or ''" />
                                </td>
                                <td class="cgrn-td-num">
                                    <span t-esc="'{0:,.2f}'.format(move.quantity or 0.0)" />
                                </td>
                                <td class="cgrn-td-num">
                                    <span t-esc="'{0:,.2f}'.format(move.line_unit_price or 0.0)" />
                                </td>
                                <td class="cgrn-td-num">
                                    <span t-esc="'{0:,.2f}'.format(line_total)" />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="cgrn-totals-wrap">
                <div class="cgrn-totals-row">
                    <span class="cgrn-totals-label">Total Birr</span>
                    <span class="cgrn-totals-value">
                        <span class="cgrn-field-line cgrn-field-line-dashed">
                            <span t-esc="'{0:,.2f}'.format(o.get_grn_grand_total())" />
                        </span>
                    </span>
                </div>
                <div class="cgrn-totals-row">
                    <span class="cgrn-totals-label">Birr in Word</span>
                    <span class="cgrn-totals-value">
                        <span class="cgrn-field-line cgrn-field-line-dashed">
                            <span t-esc="o.get_grn_amount_in_words()" />
                        </span>
                    </span>
                </div>
            </div>

            <!-- Approval + copy distribution pinned to the bottom of the page -->
            <div style="position: absolute; left: 20px; right: 20px; bottom: 0;">
                <t t-call="stock_picking_custom.op_approval_line">
                    <t t-set="prepared_name" t-value="o.create_uid.name"/>
                    <t t-set="received_name" t-value="storeman_user.name if storeman_user else ''"/>
                    <t t-set="approved_name" t-value="o.approved_by.name or ''"/>
                </t>
                <div class="cgrn-copy-dist" style="display: block; width: 100%; text-align: center;">
                    <strong>Copy Distribution:</strong>
                    Original-Store
                    <span style="margin-left: 16px;">1st Copy Finance</span>
                </div>
            </div>

        </div>
    </template>

