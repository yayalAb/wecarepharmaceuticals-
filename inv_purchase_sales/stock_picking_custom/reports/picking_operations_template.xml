        </t>
    </template>

    <template id="gpa_body">
        <style type="text/css">
            .gpa-page {
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
                font-size: 11px;
                color: #000;
                padding: 0 4px 12px;
            }
            .gpa-title {
                text-align: center;
                font-size: 16px;
                font-weight: bold;
                color: #c00000;
                margin: 0 0 14px 0;
                letter-spacing: 0.3px;
            }
            .gpa-field {
                margin-bottom: 12px;
                font-size: 10px;
                overflow: hidden;
                width: 100%;
            }
            .gpa-lbl {
                font-weight: bold;
                float: left;
                margin-right: 6px;
                padding-bottom: 3px;
                line-height: 1.35;
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
            }
            .gpa-und {
                display: block;
                overflow: hidden;
                border-bottom: 1px solid #000;
                min-height: 18px;
                padding: 0 0 5px 2px;
                margin-bottom: 2px;
                vertical-align: bottom;
            }
            .gpa-section {
                font-weight: bold;
                margin: 12px 0 6px 0;
                font-size: 11px;
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
            }
            .gpa-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5px;
                margin-bottom: 10px;
                table-layout: fixed;
            }
            .gpa-table th,
            .gpa-table td {
                border: 1px solid #000;
                padding: 4px 3px;
                vertical-align: middle;
                word-wrap: break-word;
            }
            .gpa-table th {
                background: #f0f0f0;
                font-weight: bold;
                text-align: center;
                line-height: 1.25;
            }
            .gpa-num { text-align: right; white-space: nowrap; }
            .gpa-center { text-align: center; }
            .gpa-desc { text-align: left; }
            .gpa-cols {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 10px;
                font-size: 10px;
            }
            .gpa-col {
                display: table-cell;
                width: 50%;
                vertical-align: top;
                padding-right: 14px;
            }
            .gpa-col-right {
                display: table-cell;
                width: 50%;
                vertical-align: top;
                padding-left: 20px;
            }
            .gpa-totals {
                width: 55%;
                margin-left: auto;
                margin-top: 8px;
                margin-bottom: 10px;
                font-size: 10px;
            }
            .gpa-totals-row {
                display: table;
                width: 100%;
                margin-bottom: 6px;
                table-layout: fixed;
            }
            .gpa-totals-lbl {
                display: table-cell;
                font-weight: bold;
                width: 110px;
                vertical-align: bottom;
                padding-right: 8px;
                padding-bottom: 4px;
            }
            .gpa-totals-val {
                display: table-cell;
                vertical-align: bottom;
            }
            .gpa-line {
                border-bottom: 1px solid #000;
                min-height: 22px;
                padding: 0 2px 5px 2px;
                margin-bottom: 6px;
            }
            .gpa-quality {
                margin: 10px 0;
                font-size: 10px;
                font-weight: bold;
                font-family: 'Noto Sans Ethiopic', 'Times New Roman', serif;
            }
            .gpa-appr {
                margin-top: 6px;
                font-size: 10px;
            }
            .gpa-appr-row {
                display: table;
                width: 100%;
                table-layout: fixed;
                margin-bottom: 14px;
                padding-bottom: 14px;
                border-bottom: 1px dotted #aaa;
            }
            .gpa-appr-row:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }
            .gpa-appr-title {
                display: table-cell;
                vertical-align: bottom;
                font-weight: bold;
                width: 20%;
                padding: 0 10px 4px 0;
                line-height: 1.3;
            }
            .gpa-appr-slot {
                display: table-cell;
                vertical-align: bottom;
                width: 26.67%;
                padding: 0 12px 0 0;
            }
            .gpa-appr-slot .gpa-field { margin-bottom: 0; }
            .gpa-appr-slot .gpa-lbl { font-weight: normal; }
            .gpa-appr-slot .gpa-und { min-height: 16px; padding-bottom: 4px; }
            .gpa-copy {
                margin-top: 16px;
                font-size: 10px;
                border-top: 1px solid #ccc;
                padding-top: 8px;
                text-align: center;
            }
        </style>

        <t t-set="gpa_customer" t-value="o.get_gpa_customer()" />
        <t t-set="storeman_user"
            t-value="o.location_id.warehouse_id.storeman_id if o.location_id and o.location_id.warehouse_id else False" />
        <t t-set="customer_phone" t-value="gpa_customer.phone or gpa_customer.mobile or ''" />
        <t t-set="driver_name" t-value="o.driver_name or ''" />
        <t t-set="driver_address" t-value="gpa_customer.contact_address or ''" />

        <div class="page gpa-page" style="position: relative; min-height: 850px; padding-bottom: 110px;">
            <div class="oe_structure" />

            <t t-call="stock_picking_custom.op_info_boxes">
                <t t-set="info_left" t-value="[('To', gpa_customer.display_name), ('TIN No', gpa_customer.vat), ('Address', gpa_customer.contact_address_complete), ('Ref.', o.origin), ('Remark', o.note)]" />
                <t t-set="info_right" t-value="[('Voucher No', o.name), ('Date', (context_timestamp((o.date_done or o.scheduled_date)).strftime('%d/%m/%Y %H:%M:%S') if (o.date_done or o.scheduled_date) else '')), ('Driver', o.driver_name), ('Truck No', o.vehicle_plate), ('Store', '=&gt;' + (o.location_id.complete_name or ''))]" />
            </t>

            <table class="gpa-table">
                <thead style="display: table-header-group;">
                    <tr>
                        <th style="width:4%;">S.N</th>
                        <th style="width:34%; text-align: left;">Item Description</th>
                        <th style="width:8%;">UOM</th>
                        <th style="width:10%;">Demand</th>
                        <th style="width:10%;">Quantity</th>
                        <th style="width:11%;">Unit Price</th>
                        <th style="width:13%;">Total Unit Price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="row_count" t-value="0" />
                    <t t-foreach="o.move_ids_without_package" t-as="move">
                        <t t-if="move.state != 'cancel'">
                            <t t-set="row_count" t-value="row_count + 1" />
                            <t t-set="line_total" t-value="o.get_grn_line_total(move)" />
                            <tr style="page-break-inside: avoid;">
                                <td class="gpa-center"><span t-esc="row_count" /></td>
                                <td class="gpa-desc"><div t-esc="move.product_id.name or move.name or ''" /><div t-foreach="move.get_report_lot_lines()" t-as="lot_line" t-esc="lot_line" style="font-size: 0.9em;" /></td>
                                <td class="gpa-center"><span t-esc="move.product_uom.name or ''" /></td>
                                <td class="gpa-num"><span t-esc="'{0:,.2f}'.format(move.product_uom_qty or 0.0)" /></td>
                                <td class="gpa-num"><span t-esc="'{0:,.2f}'.format(move.quantity or 0.0)" /></td>
                                <td class="gpa-num"><span t-esc="'{0:,.2f}'.format(move.line_unit_price or 0.0)" /></td>
                                <td class="gpa-num"><span t-esc="'{0:,.2f}'.format(line_total)" /></td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="gpa-totals">
                <div class="gpa-totals-row">
                    <span class="gpa-totals-lbl">Total Birr</span>
                    <span class="gpa-totals-val">
                        <div class="gpa-und"><span t-esc="'{0:,.2f}'.format(o.get_grn_grand_total())" /></div>
                    </span>
                </div>
                <div class="gpa-totals-row">
                    <span class="gpa-totals-lbl">Birr in Word</span>
                    <span class="gpa-totals-val">
                        <div class="gpa-und"><span t-esc="o.get_grn_amount_in_words()" /></div>
                    </span>
                </div>
            </div>


            <!-- Approval + copy distribution pinned to the bottom of the page -->
            <div style="position: absolute; left: 4px; right: 4px; bottom: 0;">
                <t t-call="stock_picking_custom.op_approval_line">
                    <t t-set="prepared_name" t-value="o.create_uid.name"/>
                    <t t-set="received_name" t-value="gpa_customer.display_name if gpa_customer else (o.store_request_id.requested_by.name if o.store_request_id else '')"/>
                    <t t-set="approved_name" t-value="o.approved_by.name or ''"/>
                </t>
                <div class="gpa-copy" style="display: block; width: 100%; text-align: center;">
                    <strong>Copy Distribution:</strong>
                    Original-Guards Manager &#160;|&#160;
                    1st Copy Store Keeper &#160;|&#160;
                    2nd Copy Warehouse &#160;|&#160;
                    3rd Copy-Pad
                </div>
            </div>
        </div>
    </template>

