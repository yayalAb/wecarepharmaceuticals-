<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rename "Quotation #" / "Order #" to "Sales Requisition #" / "Sales Order #" on the
         native Quotation / Order print report, fill the letterhead's Doc Title and
         Document No boxes, and add the PREPARED BY / APPROVED BY signature block. -->
    <template id="report_saleorder_document_quotation_title" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t t-set="doc_title" t-value="'Sales Requisition' if doc.state in ('draft', 'sent') else 'Sales Order'" />
            <t t-set="doc_number" t-value="doc.name" />
            <t t-set="issue_number" t-value="'1'" />
            <t t-set="prepared_by" t-value="doc.get_proforma_prepared_by()" />
            <t t-set="approved_by" t-value="doc.get_proforma_approved_by()" />
        </xpath>
        <xpath expr="//span[@t-elif=&quot;doc.state in ['draft','sent']&quot;]" position="replace">
            <span t-elif="doc.state in ['draft','sent']">Sales Requisition # </span>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']//span[@t-else='']" position="replace">
            <span t-else="">Sales Order # </span>
        </xpath>

        <!-- Salesperson phone under the Salesperson name -->
        <xpath expr="//div[@t-field='doc.user_id']" position="after">
            <t t-set="salesperson_phone" t-value="doc.user_id.partner_id.phone or doc.user_id.partner_id.mobile"/>
            <div t-if="salesperson_phone" t-out="salesperson_phone"/>
        </xpath>

        <!-- Add a Currency column between Quantity and Unit Price -->
        <xpath expr="//th[@name='th_priceunit']" position="before">
            <th name="th_currency" class="text-end text-nowrap">Currency</th>
        </xpath>
        <xpath expr="//td[@name='td_priceunit']" position="before">
            <td name="td_currency" class="text-end text-nowrap">
                <span t-esc="doc.currency_id.name" />
            </td>
        </xpath>

        <!-- Rename "Taxes" to "VAT%" -->
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" class="text-end">VAT%</th>
        </xpath>

        <!-- Bottom dashed signature block: PREPARED BY and APPROVED BY on two columns (no table / clean lines) -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="row" style="page-break-inside: avoid; font-size: 11px; margin-top: 50px;">
                <!-- Left Column: PREPARED BY -->
                <div class="col-6" style="padding-right: 25px;">
                    <div style="font-weight: bold; font-size: 12px; margin-bottom: 14px;">
                        PREPARED BY
                    </div>
                    <div style="overflow: hidden; min-height: 22px; margin-bottom: 14px;">
                        <div style="float: left; width: 50px; font-weight: bold; line-height: 22px;">Name:</div>
                        <div style="margin-left: 55px; border-bottom: 1px dashed #000; min-height: 22px; padding-left: 6px;">
                            <!-- <span t-out="prepared_by.name if prepared_by else ''"/> -->
                        </div>
                    </div>
                    <div style="overflow: hidden; min-height: 36px;">
                        <div style="float: left; width: 50px; font-weight: bold; line-height: 36px;">Sign:</div>
                        <div style="margin-left: 55px; border-bottom: 1px dashed #000; min-height: 36px; padding-left: 6px; text-align: center;">
                            <t t-if="prepared_by and 'sign_signature' in prepared_by._fields and prepared_by.sign_signature">
                                <!-- <span t-field="prepared_by.sign_signature" t-options='{"widget": "image", "style": "max-height: 32px; max-width: 120px;"}'/> -->
                            </t>
                            <t t-elif="prepared_by and 'employee_id' in prepared_by._fields and prepared_by.employee_id and 'emp_signature' in prepared_by.employee_id._fields and prepared_by.employee_id.emp_signature">
                                <!-- <span t-field="prepared_by.employee_id.emp_signature" t-options='{"widget": "image", "style": "max-height: 32px; max-width: 120px;"}'/> -->
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Right Column: APPROVED BY -->
                <div class="col-6" style="padding-left: 25px;">
                    <div style="font-weight: bold; font-size: 12px; margin-bottom: 14px;">
                        APPROVED BY
                    </div>
                    <div style="overflow: hidden; min-height: 22px; margin-bottom: 14px;">
                        <div style="float: left; width: 50px; font-weight: bold; line-height: 22px;">Name:</div>
                        <div style="margin-left: 55px; border-bottom: 1px dashed #000; min-height: 22px; padding-left: 6px;">
                            <!-- <span t-out="approved_by.name if approved_by else ''"/> -->
                        </div>
                    </div>
                    <div style="overflow: hidden; min-height: 36px;">
                        <div style="float: left; width: 50px; font-weight: bold; line-height: 36px;">Sign:</div>
                        <div style="margin-left: 55px; border-bottom: 1px dashed #000; min-height: 36px; padding-left: 6px; text-align: center;">
                            <t t-if="approved_by and 'sign_signature' in approved_by._fields and approved_by.sign_signature">
                                <!-- <span t-field="approved_by.sign_signature" t-options='{"widget": "image", "style": "max-height: 32px; max-width: 120px;"}'/> -->
                            </t>
                            <t t-elif="approved_by and 'employee_id' in approved_by._fields and approved_by.employee_id and 'emp_signature' in approved_by.employee_id._fields and approved_by.employee_id.emp_signature">
                                <!-- <span t-field="approved_by.employee_id.emp_signature" t-options='{"widget": "image", "style": "max-height: 32px; max-width: 120px;"}'/> -->
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Rename the "Untaxed Amount" subtotal label to "Total Unit Amount" on sale reports -->
    <template id="sale_document_tax_totals_untaxed_label" inherit_id="sale.document_tax_totals">
        <xpath expr="//span[@t-out=&quot;subtotal['name']&quot;]" position="replace">
            <span t-out="'Total Unit Amount' if subtotal['name'] == 'Untaxed Amount' else subtotal['name']">Untaxed Amount</span>
        </xpath>
    </template>
</odoo>
