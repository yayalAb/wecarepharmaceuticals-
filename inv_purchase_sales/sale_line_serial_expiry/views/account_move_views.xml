<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_lot" model="ir.ui.view">
        <field name="name">account.move.form.invoice.lot</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="lot_id"
                       string="Serial Number"
                       optional="show"
                       invisible="display_type"
                       readonly="1"/>
                <field name="expiration_date"
                       string="Expiration Date"
                       optional="show"
                       invisible="display_type or not lot_id"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
