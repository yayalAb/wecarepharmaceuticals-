<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for OWL Dashboard -->
    <record id="action_wecare_executive_dashboard" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">wecare_executive_dashboard.main_view</field>
    </record>

    <!-- Top-Level Root Menu for Quick Executive Access -->
    <menuitem
        id="menu_wecare_executive_dashboard_root"
        name="Executive Dashboard"
        action="action_wecare_executive_dashboard"
        sequence="5"
        web_icon="wecare_executive_dashboard,static/description/icon.png"
        groups="base.group_user"/>

    <!-- Inside Sales App -> Reporting -->
    <menuitem
        id="menu_wecare_executive_dashboard_sale"
        name="Executive Dashboard"
        parent="sale.menu_sale_report"
        action="action_wecare_executive_dashboard"
        sequence="1"
        groups="base.group_user"/>

    <!-- Inside Invoicing/Accounting App -> Reporting -->
    <menuitem
        id="menu_wecare_executive_dashboard_account"
        name="Executive Dashboard"
        parent="account.menu_finance_reports"
        action="action_wecare_executive_dashboard"
        sequence="1"
        groups="base.group_user"/>
</odoo>
