<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wecare" model="ir.module.category">
        <field name="name">WeCare Sales Management</field>
        <field name="description">Sales planning, cheque management and weekly reporting</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_wecare_user" model="res.groups">
        <field name="name">WeCare User</field>
        <field name="category_id" ref="module_category_wecare"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_wecare_manager" model="res.groups">
        <field name="name">WeCare Manager</field>
        <field name="category_id" ref="module_category_wecare"/>
        <field name="implied_ids" eval="[(4, ref('group_wecare_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_sales_plan_company" model="ir.rule">
        <field name="name">WeCare Sales Plan: company</field>
        <field name="model_id" ref="model_wecare_sales_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sales_target_company" model="ir.rule">
        <field name="name">WeCare Sales Target: company</field>
        <field name="model_id" ref="model_wecare_sales_target_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cheque_company" model="ir.rule">
        <field name="name">WeCare Cheque: company</field>
        <field name="model_id" ref="model_wecare_cheque_register"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_territory_company" model="ir.rule">
        <field name="name">WeCare Territory: company</field>
        <field name="model_id" ref="model_wecare_sales_territory"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
