<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_share_media_wizard" model="ir.ui.view">
        <field name="name">wecare.share.media.wizard.form</field>
        <field name="model">wecare.share.media.wizard</field>
        <field name="arch" type="xml">
            <form string="Share to Media">
                <group>
                    <group>
                        <field name="document_name" readonly="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="report_xmlid" invisible="1"/>
                        <field name="channel" widget="radio"/>
                        <field name="partner_id"/>
                        <field name="phone" invisible="channel != 'whatsapp'" required="channel == 'whatsapp'"/>
                        <field name="telegram_username" invisible="channel != 'telegram'" required="channel == 'telegram'"/>
                    </group>
                    <group>
                        <field name="attachment_id"/>
                    </group>
                </group>
                <separator string="Message (editable before send)"/>
                <field name="message" placeholder="Message to send with the document"/>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button name="action_download_pdf" type="object" string="Download PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
