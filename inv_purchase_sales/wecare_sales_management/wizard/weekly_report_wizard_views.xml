<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_weekly_report_wizard" model="ir.ui.view">
        <field name="name">wecare.weekly.report.wizard.form</field>
        <field name="model">wecare.weekly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Weekly Reports">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="reporting_date"/>
                    </group>
                    <group>
                        <field name="salesperson_id"/>
                        <field name="partner_id"/>
                        <field name="journal_id"/>
                        <field name="cheque_state"/>
                        <field name="classification"/>
                        <field name="credit_only"/>
                        <field name="print_title" invisible="1"/>
                        <field name="print_classification" invisible="1"/>
                    </group>
                </group>
                <separator string="Weekly collection &amp; deposits"/>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button name="action_print_collection" type="object"
                            string="Weekly Collection / CK Received" class="btn-primary"/>
                    <button name="action_print_bank_deposit" type="object"
                            string="Weekly Bank Deposited Credit/Cash Sales" class="btn-primary"/>
                </div>
                <separator string="Cheque classification"/>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button name="action_print_current" type="object" string="Current Cheques"/>
                    <button name="action_print_previous" type="object" string="Previous Cheques"/>
                    <button name="action_print_bounce" type="object" string="Bounced Cheques"/>
                    <button name="action_view_cheques" type="object" string="View Cheques"/>
                </div>
                <separator string="Performance &amp; bank summary"/>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button name="action_print_collection_performance" type="object"
                            string="Salesperson Collection Performance"/>
                    <button name="action_print_bank_summary" type="object"
                            string="Bank Deposit Summary"/>
                </div>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wecare_weekly_report_wizard" model="ir.actions.act_window">
        <field name="name">Weekly Reports</field>
        <field name="res_model">wecare.weekly.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
