<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_target_actual_wizard" model="ir.ui.view">
        <field name="name">wecare.target.actual.wizard.form</field>
        <field name="model">wecare.target.actual.wizard</field>
        <field name="arch" type="xml">
            <form string="Target vs Actual">
                <group>
                    <group>
                        <field name="plan_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="salesperson_id"/>
                        <field name="product_id"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list create="0" delete="0">
                        <field name="salesperson_id"/>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="target_qty"/>
                        <field name="actual_qty"/>
                        <field name="target_revenue"/>
                        <field name="actual_revenue"/>
                        <field name="achievement_pct"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print PDF"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wecare_target_actual_wizard" model="ir.actions.act_window">
        <field name="name">Target vs Actual</field>
        <field name="res_model">wecare.target.actual.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
