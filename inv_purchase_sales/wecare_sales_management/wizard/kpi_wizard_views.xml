<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_kpi_wizard" model="ir.ui.view">
        <field name="name">wecare.kpi.wizard.form</field>
        <field name="model">wecare.kpi.wizard</field>
        <field name="arch" type="xml">
            <form string="Management KPIs">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group string="Sales">
                    <field name="sales_target"/>
                    <field name="actual_sales"/>
                    <field name="achievement_pct"/>
                </group>
                <group string="Collections &amp; Cheques">
                    <field name="customer_collection"/>
                    <field name="current_deposited"/>
                    <field name="previous_deposited"/>
                    <field name="bounce_amount"/>
                    <field name="outstanding_collection"/>
                </group>
                <footer>
                    <button name="action_compute" type="object" string="Refresh KPIs" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wecare_kpi_wizard" model="ir.actions.act_window">
        <field name="name">Management KPIs</field>
        <field name="res_model">wecare.kpi.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
