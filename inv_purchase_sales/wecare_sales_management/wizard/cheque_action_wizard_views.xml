<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bounce Wizard View -->
    <record id="view_wecare_cheque_bounce_wizard_form" model="ir.ui.view">
        <field name="name">wecare.cheque.bounce.wizard.form</field>
        <field name="model">wecare.cheque.bounce.wizard</field>
        <field name="arch" type="xml">
            <form string="Cheque Bounce Processing">
                <group>
                    <group>
                        <field name="cheque_no"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="bounce_date"/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                </group>
                <group>
                    <field name="bounce_reason" placeholder="Enter bank bounce reason (e.g. Insufficient Funds)..."/>
                </group>
                <div class="alert alert-warning" role="alert">
                    <strong>Note:</strong> Marking this cheque as bounced will reverse/cancel any linked payment and restore the outstanding balance on the allocated invoices without duplicating them.
                </div>
                <footer>
                    <button name="action_confirm_bounce" string="Confirm Bounce" type="object" class="btn-danger"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Cancel Wizard View -->
    <record id="view_wecare_cheque_cancel_wizard_form" model="ir.ui.view">
        <field name="name">wecare.cheque.cancel.wizard.form</field>
        <field name="model">wecare.cheque.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Cheque Registration">
                <group>
                    <group>
                        <field name="cheque_no"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="cancel_date"/>
                    </group>
                </group>
                <group>
                    <field name="cancel_reason" placeholder="Enter authorized cancellation reason..."/>
                </group>
                <div class="alert alert-danger" role="alert">
                    <strong>Warning:</strong> Cancelling this cheque will void the collection and cancel any associated accounting payment. Full history and reason will be saved in the audit log.
                </div>
                <footer>
                    <button name="action_confirm_cancel" string="Confirm Cancellation" type="object" class="btn-danger"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
