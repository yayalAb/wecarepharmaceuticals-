<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_sales_analysis_wizard" model="ir.ui.view">
        <field name="name">wecare.sales.analysis.wizard.form</field>
        <field name="model">wecare.sales.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer / Product Sales">
                <group>
                    <group>
                        <field name="report_type" widget="radio"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="salesperson_id"/>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wecare_sales_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Customer / Product Sales</field>
        <field name="res_model">wecare.sales.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
