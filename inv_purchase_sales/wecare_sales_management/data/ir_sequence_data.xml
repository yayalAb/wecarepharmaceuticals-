<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_wecare_sales_plan" model="ir.sequence">
        <field name="name">WeCare Sales Plan</field>
        <field name="code">wecare.sales.plan</field>
        <field name="prefix">SP-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_wecare_collection" model="ir.sequence">
        <field name="name">WeCare Collection</field>
        <field name="code">wecare.cheque.register</field>
        <field name="prefix">COL-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
