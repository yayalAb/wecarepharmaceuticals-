<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_request_form_wecare_share" model="ir.ui.view">
        <field name="name">store.request.form.wecare.share</field>
        <field name="model">store.request</field>
        <field name="inherit_id" ref="store_request.view_store_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_share_to_media" type="object"
                        string="Share to Media" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
