<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_sales_plan_list" model="ir.ui.view">
        <field name="name">wecare.sales.plan.list</field>
        <field name="model">wecare.sales.plan</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'closed'">
                <field name="plan_no"/>
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="plan_period"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="team_id"/>
                <field name="manager_id"/>
                <field name="total_annual_revenue"/>
                <field name="achievement_pct"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_wecare_sales_plan_form" model="ir.ui.view">
        <field name="name">wecare.sales.plan.form</field>
        <field name="model">wecare.sales.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'submitted'" class="btn-primary"
                            groups="wecare_sales_management.group_wecare_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('submitted', 'approved')"
                            groups="wecare_sales_management.group_wecare_manager"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'approved'"
                            groups="wecare_sales_management.group_wecare_manager"/>
                    <button name="action_print_plan" type="object" string="Print Plan"/>
                    <button name="action_open_target_vs_actual" type="object" string="Target vs Actual"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_target_vs_actual" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info">
                                <field name="achievement_pct" widget="float"/>
                                <span class="o_stat_text">Achievement %</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="2026 Pharmaceutical Sales Plan"/></h1>
                        <h2><field name="plan_no" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="fiscal_year"/>
                            <field name="plan_period"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="manager_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_annual_qty"/>
                            <field name="total_annual_revenue"/>
                            <field name="total_actual_revenue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Targets" name="targets">
                            <field name="target_line_ids" readonly="state in ('approved', 'closed')">
                                <list editable="bottom">
                                    <field name="salesperson_id"/>
                                    <field name="territory_id"/>
                                    <field name="partner_id"/>
                                    <field name="customer_type"/>
                                    <field name="categ_id" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id" optional="hide"/>
                                    <field name="annual_qty"/>
                                    <field name="unit_price"/>
                                    <field name="annual_revenue"/>
                                    <field name="monthly_target" optional="hide"/>
                                    <field name="actual_qty" optional="show"/>
                                    <field name="actual_revenue" optional="show"/>
                                    <field name="achievement_pct" optional="show"/>
                                    <field name="state" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <button name="action_distribute_evenly" type="object"
                                            string="Split months" icon="fa-calendar"/>
                                </list>
                            </field>
                        </page>
                        <page string="Monthly Quantities" name="monthly">
                            <field name="target_line_ids" readonly="state in ('approved', 'closed')">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="salesperson_id"/>
                                    <field name="product_id"/>
                                    <field name="qty_jan"/>
                                    <field name="qty_feb"/>
                                    <field name="qty_mar"/>
                                    <field name="qty_apr"/>
                                    <field name="qty_may"/>
                                    <field name="qty_jun"/>
                                    <field name="qty_jul"/>
                                    <field name="qty_aug"/>
                                    <field name="qty_sep"/>
                                    <field name="qty_oct"/>
                                    <field name="qty_nov"/>
                                    <field name="qty_dec"/>
                                    <field name="monthly_qty_total"/>
                                    <field name="annual_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="remarks" placeholder="Additional information"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wecare_sales_plan_search" model="ir.ui.view">
        <field name="name">wecare.sales.plan.search</field>
        <field name="model">wecare.sales.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_no"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="manager_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_year" string="Fiscal Year" context="{'group_by': 'fiscal_year'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wecare_sales_plan" model="ir.actions.act_window">
        <field name="name">Sales Plans</field>
        <field name="res_model">wecare.sales.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_approved': 1}</field>
    </record>

    <record id="view_wecare_target_line_list" model="ir.ui.view">
        <field name="name">wecare.sales.target.line.report.list</field>
        <field name="model">wecare.sales.target.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" open_form_view="false">
                <header>
                    <button name="action_print_target_vs_actual" type="object" string="Print Target vs Actual"/>
                </header>
                <field name="plan_id"/>
                <field name="salesperson_id"/>
                <field name="territory_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="customer_type" optional="hide"/>
                <field name="product_id"/>
                <field name="annual_qty" sum="Target Qty"/>
                <field name="actual_qty"/>
                <field name="annual_revenue" sum="Target Revenue"/>
                <field name="actual_revenue"/>
                <field name="achievement_pct"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wecare_target_line_search" model="ir.ui.view">
        <field name="name">wecare.sales.target.line.search</field>
        <field name="model">wecare.sales.target.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="salesperson_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="plan_id"/>
                <field name="territory_id"/>
                <filter name="approved" string="Approved Plans" domain="[('state', '=', 'approved')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_territory" string="Territory" context="{'group_by': 'territory_id'}"/>
                    <filter name="group_plan" string="Sales Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_type" string="Customer Type" context="{'group_by': 'customer_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wecare_target_vs_actual" model="ir.actions.act_window">
        <field name="name">Target vs Actual</field>
        <field name="res_model">wecare.sales.target.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_wecare_target_line_list"/>
        <field name="search_view_id" ref="view_wecare_target_line_search"/>
        <field name="context">{
            'search_default_approved': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sales targets</p>
            <p>Filter by salesperson, customer or product, use Group By, then Print Target vs Actual.</p>
        </field>
    </record>
</odoo>
