<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_cheque_register_list" model="ir.ui.view">
        <field name="name">wecare.cheque.register.list</field>
        <field name="model">wecare.cheque.register</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'bounced'" decoration-success="state == 'cleared'" decoration-warning="state == 'received'">
                <header>
                    <button name="action_print_weekly_collection" type="object" string="Print Collection"/>
                    <button name="action_print_weekly_bank_deposit" type="object" string="Print Bank Deposited"/>
                    <button name="action_print_current_cheques" type="object" string="Print Current"/>
                    <button name="action_print_previous_cheques" type="object" string="Print Previous"/>
                    <button name="action_print_bounced_cheques" type="object" string="Print Bounced"/>
                    <button name="action_print_collection_performance" type="object" string="Print Performance"/>
                    <button name="action_print_bank_summary" type="object" string="Print Bank Summary"/>
                </header>
                <field name="collection_no"/>
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="cheque_date"/>
                <field name="received_date"/>
                <field name="deposit_date"/>
                <field name="journal_id"/>
                <field name="is_credit_sale" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'received'"
                       decoration-info="state == 'deposited'"
                       decoration-success="state == 'cleared'"
                       decoration-danger="state == 'bounced'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_wecare_cheque_register_form" model="ir.ui.view">
        <field name="name">wecare.cheque.register.form</field>
        <field name="model">wecare.cheque.register</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_deposit" type="object" string="Deposit"
                            invisible="state != 'received'" class="btn-primary"/>
                    <button name="action_clear" type="object" string="Cleared"
                            invisible="state != 'deposited'" class="btn-primary"/>
                    <button name="action_bounce" type="object" string="Bounced"
                            invisible="state not in ('received', 'deposited')"
                            class="btn-danger"/>
                    <button name="action_redeposit" type="object" string="Re-deposit"
                            invisible="state != 'bounced'" class="btn-primary"/>
                    <button name="action_open_payment" type="object" string="Payment"
                            invisible="not payment_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,deposited,cleared,bounced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="CK-45821"/></h1>
                        <h2><field name="collection_no" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="payment_type"/>
                            <field name="collection_type"/>
                            <field name="partner_id"/>
                            <field name="salesperson_id"/>
                            <field name="invoice_ids" widget="many2many_tags"/>
                            <field name="payment_id"/>
                            <field name="is_credit_sale"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cheque_date"/>
                            <field name="received_date"/>
                            <field name="deposit_date"/>
                            <field name="journal_id"/>
                            <field name="partner_bank_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Bounce / Re-deposit" invisible="state != 'bounced' and not original_cheque_id">
                        <group>
                            <field name="bounce_date"/>
                            <field name="bounce_reason"/>
                            <field name="outstanding"/>
                        </group>
                        <group>
                            <field name="original_cheque_id"/>
                            <field name="redeposit_date"/>
                            <field name="redeposit_ids"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wecare_cheque_register_search" model="ir.ui.view">
        <field name="name">wecare.cheque.register.search</field>
        <field name="model">wecare.cheque.register</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="collection_no"/>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="journal_id"/>
                <field name="state"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="deposited" string="Deposited" domain="[('state', '=', 'deposited')]"/>
                <filter name="cleared" string="Cleared" domain="[('state', '=', 'cleared')]"/>
                <filter name="bounced" string="Bounced" domain="[('state', '=', 'bounced')]"/>
                <filter name="open_bounce" string="Current Existing Bounce" domain="[('outstanding', '=', True)]"/>
                <filter name="inbound" string="Customer Collections" domain="[('payment_type', '=', 'inbound')]"/>
                <filter name="outbound" string="Vendor Payments" domain="[('payment_type', '=', 'outbound')]"/>
                <filter name="credit" string="Credit Sales" domain="[('is_credit_sale', '=', True)]"/>
                <filter name="cash" string="Cash Sales" domain="[('is_credit_sale', '=', False)]"/>
                <separator/>
                <filter name="filter_received_date" string="Received Date" date="received_date"/>
                <filter name="filter_deposit_date" string="Deposit Date" date="deposit_date"/>
                <filter name="filter_cheque_date" string="Cheque Date" date="cheque_date"/>
                <filter name="filter_bounce_date" string="Bounce Date" date="bounce_date"/>
                <group>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_bank" string="Bank" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_credit" string="Credit / Cash" context="{'group_by': 'is_credit_sale'}"/>
                    <filter name="group_received" string="Received Date" context="{'group_by': 'received_date'}"/>
                    <filter name="group_deposit" string="Deposit Date" context="{'group_by': 'deposit_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wecare_weekly_reports" model="ir.actions.act_window">
        <field name="name">Weekly Reports</field>
        <field name="res_model">wecare.cheque.register</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_inbound': 1,
            'search_default_group_salesperson': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No collections in this filter</p>
            <p>Use Filters (Received Date, Salesperson, Bank, Status) and Group By, then Print from the buttons or the Print menu.</p>
        </field>
    </record>

    <record id="action_wecare_cheque_register" model="ir.actions.act_window">
        <field name="name">Cheque Register</field>
        <field name="res_model">wecare.cheque.register</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_inbound': 1}</field>
    </record>

    <record id="action_wecare_bounced_cheques" model="ir.actions.act_window">
        <field name="name">Bounced Cheques</field>
        <field name="res_model">wecare.cheque.register</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'bounced')]</field>
        <field name="context">{'search_default_bounced': 1}</field>
    </record>

    <record id="action_wecare_outstanding_invoices" model="ir.actions.act_window">
        <field name="name">Outstanding Collections</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
    </record>

    <record id="action_wecare_vendor_cheques" model="ir.actions.act_window">
        <field name="name">Vendor Cheque Payments</field>
        <field name="res_model">wecare.cheque.register</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'outbound')]</field>
        <field name="context">{'default_payment_type': 'outbound'}</field>
    </record>
</odoo>
