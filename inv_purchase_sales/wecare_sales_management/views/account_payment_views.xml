<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_wecare_share" model="ir.ui.view">
        <field name="name">account.payment.form.wecare.share</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_share_to_media" type="object"
                        string="Share to Media"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_wecare_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.wecare.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="custom_payment.view_account_payment_form_maturity_date"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_transfer_no']" position="after">
                <field name="cheque_register_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
