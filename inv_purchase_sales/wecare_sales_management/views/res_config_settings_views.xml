<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wecare" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wecare</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="WeCare Sales Management" name="wecare_sales_setting">
                    <setting string="Deduct Stock on Invoice Validation"
                             help="When a customer invoice is posted, automatically validate the related delivery order so stock (location, batch, expiry) is deducted at invoice confirmation.">
                        <field name="wecare_deduct_stock_on_invoice"/>
                    </setting>
                    <setting string="Expiry Notification Days"
                             help="Create activities for stock managers when a lot/batch expires within this many days.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="wecare_expiry_notify_days" class="col-lg-4 o_light_label" string="Days"/>
                                <field name="wecare_expiry_notify_days" class="col-lg-2"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
