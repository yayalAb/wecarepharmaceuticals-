<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_wecare_original_document_request_list" model="ir.ui.view">
        <field name="name">wecare.original.document.request.list</field>
        <field name="model">wecare.original.document.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="status in ('draft', 'submitted')"
                  decoration-info="status == 'reviewed'"
                  decoration-success="status == 'approved'"
                  decoration-muted="status == 'cancelled'">
                <field name="name"/>
                <field name="sales_order_id"/>
                <field name="partner_id"/>
                <field name="customer_reference" optional="show"/>
                <field name="salesperson_id" optional="show"/>
                <field name="request_date"/>
                <field name="requested_person"/>
                <field name="reviewer_id" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="status" widget="badge"
                       decoration-warning="status in ('draft', 'submitted')"
                       decoration-info="status == 'reviewed'"
                       decoration-success="status == 'approved'"
                       decoration-muted="status == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wecare_original_document_request_form" model="ir.ui.view">
        <field name="name">wecare.original.document.request.form</field>
        <field name="model">wecare.original.document.request</field>
        <field name="arch" type="xml">
            <form string="Original Document Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="status != 'draft'" class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            invisible="status != 'submitted'" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="status != 'reviewed'" class="btn-primary"
                            groups="wecare_sales_management.group_wecare_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="status not in ('cancelled', 'submitted')" class="btn-secondary"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status in ('approved', 'cancelled')" class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Request Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Order &amp; Customer Information">
                            <field name="sales_order_id" options="{'no_create': True}"
                                   readonly="status in ('reviewed', 'approved', 'cancelled')"/>
                            <field name="partner_id"/>
                            <field name="customer_reference"/>
                            <field name="salesperson_id"/>
                        </group>
                        <group string="Request Details">
                            <field name="request_date" readonly="status in ('reviewed', 'approved', 'cancelled')"/>
                            <field name="requested_person" options="{'no_create': True}"
                                   readonly="status in ('reviewed', 'approved', 'cancelled')"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="status != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason &amp; Notes" name="reason_notes">
                            <group>
                                <field name="reason" placeholder="Provide the reason for requesting original documents..."
                                       required="1"
                                       readonly="status in ('approved', 'cancelled')"/>
                                <field name="notes" placeholder="Internal remarks / comments..."
                                       readonly="status in ('approved', 'cancelled')"/>
                            </group>
                        </page>
                        <page string="Audit &amp; Approvals" name="audit_trail">
                            <group>
                                <group string="Review Details">
                                    <field name="reviewer_id"/>
                                    <field name="review_date"/>
                                </group>
                                <group string="Approval Details">
                                    <field name="approver_id"/>
                                    <field name="approval_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_wecare_original_document_request_search" model="ir.ui.view">
        <field name="name">wecare.original.document.request.search</field>
        <field name="model">wecare.original.document.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="sales_order_id" string="Sales Order"/>
                <field name="customer_reference" string="Customer Reference"/>
                <field name="partner_id" string="Customer"/>
                <field name="requested_person" string="Requested Person"/>
                <field name="reviewer_id" string="Reviewer"/>
                <field name="approver_id" string="Approver"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('status', '=', 'submitted')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('status', '=', 'reviewed')]"/>
                <filter name="approved" string="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter name="my_requests" string="My Requests" domain="[('requested_person', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_requested_person" string="Requested Person" context="{'group_by': 'requested_person'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Request Date" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wecare_original_document_request" model="ir.actions.act_window">
        <field name="name">Original Document Requests</field>
        <field name="res_model">wecare.original.document.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Original Document Request
            </p>
            <p>
                Track and manage requests for original sales documents through review and approval workflow.
            </p>
        </field>
    </record>
</odoo>
