<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_scrap_form_wecare_share" model="ir.ui.view">
        <field name="name">stock.scrap.form.wecare.share</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_share_to_media" type="object"
                        string="Share to Media" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
