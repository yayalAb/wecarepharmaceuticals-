<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_wecare_share" model="ir.ui.view">
        <field name="name">sale.order.form.wecare.share</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_share_to_media" type="object"
                        string="Share to Media"
                        class="btn-secondary"
                        groups="wecare_sales_management.group_sale_order_button_share_media"
                        invisible="state == 'cancel'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_share_history" type="object"
                        class="oe_stat_button" icon="fa-share-alt"
                        invisible="not share_history_count">
                    <field name="share_history_count" widget="statinfo" string="Shares"/>
                </button>
                <button name="action_view_original_doc_requests" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="state not in ('sale', 'done')">
                    <field name="original_doc_request_count" widget="statinfo" string="Doc Requests"/>
                </button>
            </div>
            <!-- Warehouse on the order header (after Payment Method); the order Stock Location
                 stays hidden and only serves as the default for new lines. -->
            <xpath expr="//field[@name='payment_method']" position="after">
                <field name="warehouse_id" options="{'no_create': True}" force_save="1"
                       readonly="state == 'sale'"/>
                <field name="stock_location_id" invisible="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="stock_location_id" optional="show" invisible="display_type in ('line_section', 'line_note')"
                       options="{'no_create': True}"
                       domain="[('usage', '=', 'internal'), ('warehouse_id', '=?', parent.warehouse_id), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
            </xpath>
            <!-- Restrict customer selection to company-type partners only (not individuals) -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True), ('customer_rank', '>', 0)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_wecare_location" model="ir.ui.view">
        <field name="name">sale.order.form.wecare.location</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <!-- Hide the Other Info warehouse: it is shown on the order header instead -->
            <xpath expr="//group[@name='sale_shipping']//field[@name='warehouse_id'][@force_save='1']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Sales Order Button Security Groups (Buttons 1 to 7) -->
    <record id="view_order_form_button_groups" model="ir.ui.view">
        <field name="name">sale.order.form.button.groups</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!-- 1. Send by Email -->
            <xpath expr="//header/button[@id='send_by_email_primary']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_send_by_email</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_by_email']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_send_by_email</attribute>
            </xpath>

            <!-- 2. Send PRO-FORMA Invoice -->
            <xpath expr="//header/button[@id='send_proforma_primary']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_send_proforma</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_send_proforma</attribute>
            </xpath>

            <!-- 3. Confirm -->
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_confirm</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][@data-hotkey='q'][not(@id)]" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_confirm</attribute>
            </xpath>

            <!-- 4. Cancel -->
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_cancel</attribute>
            </xpath>

            <!-- 6. Create Invoice -->
            <xpath expr="//header/button[@id='create_invoice']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_create_invoice</attribute>
            </xpath>
            <xpath expr="//header/button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_create_invoice</attribute>
            </xpath>

            <!-- 7. Unlock -->
            <xpath expr="//header/button[@name='action_unlock']" position="attributes">
                <attribute name="groups">wecare_sales_management.group_sale_order_button_unlock</attribute>
            </xpath>
        </field>
    </record>

</odoo>
