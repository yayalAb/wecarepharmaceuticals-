<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_wecare_share" model="ir.ui.view">
        <field name="name">sale.order.form.wecare.share</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_share_to_media" type="object"
                        string="Share to Media"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_share_history" type="object"
                        class="oe_stat_button" icon="fa-share-alt"
                        invisible="not share_history_count">
                    <field name="share_history_count" widget="statinfo" string="Shares"/>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="stock_location_id" optional="show" invisible="display_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_wecare_location" model="ir.ui.view">
        <field name="name">sale.order.form.wecare.location</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id'][@invisible='1']" position="after">
                <field name="stock_location_id"/>
            </xpath>
        </field>
    </record>
</odoo>
