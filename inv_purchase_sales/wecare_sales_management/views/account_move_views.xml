<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_wecare" model="ir.ui.view">
        <field name="name">account.move.form.wecare</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_share_to_media" type="object"
                        string="Share to Media"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="stock_location_id" optional="show"
                       invisible="display_type" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
