<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wecare_sales_territory_list" model="ir.ui.view">
        <field name="name">wecare.sales.territory.list</field>
        <field name="model">wecare.sales.territory</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="salesperson_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_wecare_sales_territory_form" model="ir.ui.view">
        <field name="name">wecare.sales.territory.form</field>
        <field name="model">wecare.sales.territory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="salesperson_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wecare_sales_territory" model="ir.actions.act_window">
        <field name="name">Sales Territories</field>
        <field name="res_model">wecare.sales.territory</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
