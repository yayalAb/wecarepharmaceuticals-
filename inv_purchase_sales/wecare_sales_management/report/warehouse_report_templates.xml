<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Warehouse on the Sales Quotation / Sales Order attachment (after Payment Method) -->
    <template id="soa_body_wecare_warehouse" inherit_id="stock_picking_custom.soa_body">
        <xpath expr="//t[@t-out='doc.get_sales_attachment_payment_method()']/../.." position="after">
            <div class="soa-field">
                <span class="soa-lbl">Warehouse:</span>
                <div class="soa-und"><span t-esc="doc.warehouse_id.name or ''" /></div>
            </div>
        </xpath>
    </template>

    <!-- Warehouse on the native Sales Quotation / Order print -->
    <template id="report_saleorder_document_wecare_warehouse" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@t-field='doc.user_id']/.." position="after">
            <div t-if="doc.warehouse_id" class="col" name="informations_warehouse">
                <strong>Warehouse</strong>
                <div t-field="doc.warehouse_id.name"/>
            </div>
        </xpath>
    </template>

    <!-- Warehouse on the customer invoice print (after Salesperson) -->
    <template id="report_invoice_document_wecare_warehouse" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='salesperson']" position="after">
            <t t-set="wecare_warehouses" t-value="o.wecare_warehouse_id or o.invoice_line_ids.stock_warehouse_id"/>
            <div class="col" t-if="wecare_warehouses" name="warehouse">
                <strong>Warehouse</strong>
                <div t-out="', '.join(wecare_warehouses.mapped('name'))"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">o.invoice_date or (o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted') or o.delivery_date or o.invoice_origin or o.partner_id.ref or o.ref or o.invoice_incoterm_id or o.fs_no or o.mrc_no or o.payment_method or o.invoice_user_id or o.wecare_warehouse_id or o.invoice_line_ids.stock_warehouse_id</attribute>
        </xpath>
    </template>
</odoo>
