<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_compliance_document_list" model="ir.ui.view">
        <field name="name">customer.compliance.document.list</field>
        <field name="model">customer.compliance.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'expired'"
                  decoration-warning="status == 'expiring_soon'"
                  decoration-success="status == 'valid'">
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge"
                         decoration-danger="status == 'expired'"
                         decoration-warning="status == 'expiring_soon'"
                         decoration-success="status == 'valid'"/>
                <field name="attachment_filename" string="Attachment"/>
            </list>
        </field>
    </record>

    <record id="view_compliance_document_form" model="ir.ui.view">
        <field name="name">customer.compliance.document.form</field>
        <field name="model">customer.compliance.document</field>
        <field name="arch" type="xml">
            <form string="Compliance Document">
                <sheet>
                    <div class="oe_title">
                        <label for="document_number" string="Document Number"/>
                        <h1>
                            <field name="document_number" placeholder="e.g. TL-123456"/>
                        </h1>
                        <field name="status" widget="badge"
                                 decoration-danger="status == 'expired'"
                                 decoration-warning="status == 'expiring_soon'"
                                 decoration-success="status == 'valid'"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="document_type_id"/>
                            <field name="remarks"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_compliance_document_search" model="ir.ui.view">
        <field name="name">customer.compliance.document.search</field>
        <field name="model">customer.compliance.document</field>
        <field name="arch" type="xml">
            <search string="Compliance Documents">
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <filter name="filter_valid" string="Valid" domain="[('status', '=', 'valid')]"/>
                <filter name="filter_expiring" string="Expiring Soon" domain="[('status', '=', 'expiring_soon')]"/>
                <filter name="filter_expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <separator/>
                <filter name="groupby_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="groupby_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                <filter name="groupby_status" string="Status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_compliance_document" model="ir.actions.act_window">
        <field name="name">Compliance Documents</field>
        <field name="res_model">customer.compliance.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_compliance_document_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a customer compliance document
            </p>
            <p>
                Track trade licenses, business licenses, registrations, and certificates.
                Sales Orders cannot be confirmed when required documents are missing or expired.
            </p>
        </field>
    </record>

    <!-- Sales → Customers → Compliance Documents -->
    <menuitem id="menu_compliance_documents_root"
              name="Compliance Documents"
              parent="sale.sale_menu_root"
              sequence="45"/>

    <menuitem id="menu_compliance_documents"
              name="Customer Documents"
              parent="menu_compliance_documents_root"
              action="action_compliance_document"
              sequence="10"/>

    <menuitem id="menu_compliance_document_types"
              name="Document Types"
              parent="menu_compliance_documents_root"
              action="action_compliance_document_type"
              sequence="20"
              groups="sales_team.group_sale_manager"/>
</odoo>
