<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_compliance" model="ir.ui.view">
        <field name="name">sale.order.form.compliance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="compliance_status" string="Customer Compliance"
                         widget="badge"
                         decoration-success="compliance_status == 'ok'"
                         decoration-warning="compliance_status == 'warning'"
                         decoration-danger="compliance_status in ('blocked', 'none')"/>
                <button name="action_open_customer_compliance_documents"
                        type="object"
                        string="Compliance Docs"
                        class="btn-link"
                        invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
