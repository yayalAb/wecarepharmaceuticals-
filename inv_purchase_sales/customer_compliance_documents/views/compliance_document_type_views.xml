<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_compliance_document_type_list" model="ir.ui.view">
        <field name="name">customer.compliance.document.type.list</field>
        <field name="model">customer.compliance.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_required"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_compliance_document_type_form" model="ir.ui.view">
        <field name="name">customer.compliance.document.type.form</field>
        <field name="model">customer.compliance.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_required"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_compliance_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">customer.compliance.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
