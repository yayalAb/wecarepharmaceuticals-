<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_compliance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.compliance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Customer Compliance Documents" name="compliance_documents_setting">
                    <setting string="Block Sales Orders"
                             help="Prevent confirming Sales Orders when the customer is missing required or valid compliance documents.">
                        <field name="compliance_block_sale_orders"/>
                    </setting>
                    <setting string="Companies Only"
                             help="Only check company customers. Individual contacts are skipped."
                             invisible="not compliance_block_sale_orders">
                        <field name="compliance_require_company_only"/>
                    </setting>
                    <setting string="Expiring Soon Threshold"
                             help="Documents that expire within this many days are marked Expiring Soon.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="compliance_expiring_soon_days" class="col-lg-4 o_light_label" string="Days"/>
                                <field name="compliance_expiring_soon_days" class="col-lg-2"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
